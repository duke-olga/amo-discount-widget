<div class="promotions-widget">
     <!-- ШАПКА -->
    <div class="widget-header">
        <div class="widget-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="8" y1="12" x2="16" y2="12"></line>
            <line x1="8" y1="8" x2="12" y2="8"></line>
            <line x1="8" y1="16" x2="16" y2="16"></line>
            </svg>
        </div>
        <h1 class="widget-title">Данные сделки</h1>
    </div>

    <!-- Карточка с данными -->
    <div class="card">
        <div class="card-content">
            <!-- Строка 1: Сделка -->
            <div class="deal-name" id="w-deal-name" title="{{ deal_name }}">
                {{ deal_name|default('Загрузка...') }}
            </div>

            <!-- Линия-разделитель -->
            <div class="separator"></div>

            <!-- Строка 2: Текущий бюджет -->
            <div class="widget-row">
                <div class="widget-label">Текущий бюджет:</div>
                <div class="widget-value text-primary font-bold text-lg" id="w-deal-price">
                    {{ deal_price|default('...') }} ₽
                </div>
            </div>

            <!-- Строка 3: Клиент -->
            <div class="widget-row">
                <div class="widget-label">Клиент:</div>
                <div class="widget-value" id="w-client-name">
                    {{ client_name|default('...') }}
                </div>
            </div>

            <!-- Строка 4: Источник -->
            <div class="widget-row">
                <div class="widget-label">Источник:</div>
                <div class="widget-value">
                    <!-- Бейдж вместо простого текста -->
                    <span class="badge badge-source" id="w-client-source">
                        {{ client_source|default('Не указан') }}
                    </span>
                </div>
            </div>

        </div>
    </div>
    <!-- КОНЕЦ: Карточка с данными -->

</div>